# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# browser extension build artifacts
/apps/extension/.output/
/apps/extension/.wxt/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase local cli state
supabase/.branches/
supabase/.temp/

# local content generation artifacts
/content-assets/
/scripts/capture-launch-assets.mjs
/scripts/seed-demo-content.mjs
LAUNCH_CONTENT_DRAFTS.md

# typescript
*.tsbuildinfo
next-env.d.ts
