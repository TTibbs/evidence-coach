# Evidence Coach environment

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Comma-separated Supabase Auth OAuth providers to show on login/signup.
# Enable and configure each provider in Supabase Auth before exposing it here.
NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=google

# Postgres URI for migrations (Supabase → Project Settings → Database → URI)
# Use the "Session mode" or direct connection string, not the anon key.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Active MVP AI provider: gemini | openai | mock
AI_PROVIDER=gemini
AI_GEMINI_ENABLED=true
AI_OPENAI_ENABLED=false
AI_OPENAI_USER_ACCESS=false

# Google Gemini (required for MVP AI workflows)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SEARCH_MODEL=gemini-2.5-flash-lite

# Job confidence official-listing search
TAVILY_API_KEY=
JOB_TRUST_CACHE_TTL_SECONDS=86400
JOB_TRUST_RATE_LIMIT_PER_MINUTE=20
JOB_TRUST_EXTRACT_CANDIDATE_PAGES=false
JOB_TRUST_CANDIDATE_EXTRACTION_LIMIT=2
JOB_TRUST_CANDIDATE_FETCH_TIMEOUT_MS=2500

# OpenAI (optional / premium — not used while disabled)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Application-level free AI request limits (per user)
AI_FREE_DAILY_REQUEST_LIMIT=40
AI_FREE_MONTHLY_REQUEST_LIMIT=400

ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Raise free-tier product limits for local/beta testing (free | prepare | intensive | interview-pass)
BETA_PLAN_OVERRIDE=prepare
